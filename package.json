{
  "name": "kidshow-scout",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "serve": "node server/index.js",
    "test": "vitest run",
    "tmdb:discover": "python scripts/tmdb/1_discover.py",
    "tmdb:enrich": "python scripts/tmdb/2_enrich.py",
    "tmdb:assess": "python scripts/tmdb/3_assess.py",
    "tmdb:assess:resume": "python scripts/tmdb/3_assess.py --resume",
    "tmdb:review": "python scripts/tmdb/4_review.py",
    "tmdb:auto": "python scripts/tmdb/4_review_auto.py",
    "tmdb:auto:append": "python scripts/tmdb/4_review_auto.py --append",
    "tmdb:import": "python scripts/tmdb/5_import.py",
    "tmdb:import:auto": "python scripts/tmdb/5_import.py --yes",
    "tmdb:reassess": "python scripts/tmdb/3_assess.py",
    "tmdb:refresh": "python scripts/tmdb/7_refresh_existing.py",
    "tmdb:refresh:apply": "python scripts/tmdb/7_refresh_existing.py --apply",
    "tmdb:audit-variants": "python scripts/tmdb/8_audit_variants.py",
    "tmdb:free-sources": "python scripts/tmdb/9_enrich_free_sources.py",
    "tmdb:validate": "python scripts/tmdb/11_validate_shows.py",
    "tmdb:validate:fix": "python scripts/tmdb/11_validate_shows.py --fix",
    "tmdb:pipeline": "python scripts/tmdb/10_run_pipeline.py",
    "tmdb:pipeline:content": "python scripts/tmdb/10_run_pipeline.py --mode content",
    "tmdb:pipeline:audit": "python scripts/tmdb/10_run_pipeline.py --mode audit",
    "tmdb:pipeline:plan": "python scripts/tmdb/10_run_pipeline.py --dry-run",
    "tmdb:full": "npm run tmdb:discover && npm run tmdb:enrich && npm run tmdb:assess",
    "tmdb:sync": "npm run tmdb:full && npm run tmdb:auto && npm run tmdb:import:auto && npm run tmdb:validate:fix && npm run tmdb:refresh:apply && npm run tmdb:audit-variants && npm run tmdb:free-sources",
    "reel:studio": "remotion studio src/remotion/index.ts",
    "reel:render": "remotion render src/remotion/index.ts KidShowScoutReel dist/kidshow-scout-instagram-reel.mp4 --codec=h264 --pixel-format=yuv420p"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@remotion/cli": "^4.0.459",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^28.0.0",
    "remotion": "^4.0.459",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vitest": "^4.0.18"
  }
}
